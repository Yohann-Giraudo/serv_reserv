<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Détail hôtel</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <div class="container">
        <h1>Détail de l'hôtel</h1>

        <h1>
            <%= hotel.nom %>
        </h1>
        <img src="/hotels/<%= hotel.image || 'default.jpg' %>" 
            class="card-img-top img-fluid"
            alt="Photo de <%= hotel.nom %>">
        <p>
            <%= hotel.ville %>
        </p>
        <a href="/hotels">← Retour</a>

        <a href="/hotels">Retour à la liste</a>
    </div>

</body>

</html>