<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Titre de la page -->
    <title>QuestExplorer - Accueil</title>

    <!-- Framework CSS Bootstrap + icônes officielles -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <!-- Feuille de style personnalisée -->
    <link rel="stylesheet" href="/style.css">
</head>

<body>


    <%  // Helpers globaux pour la page home
        const DETAIL_BASE="/hotels" ;
        const getId=(h)=> h.id ?? h.id_hotel;
    %>




        <!-- ===================================================== -->
        <!-- NAVBAR (barre de navigation principale du site) -->
        <!-- ===================================================== -->
        <nav class="navbar navbar-expand-lg navbar-light bg-light shadow-sm">
            <div class="container">
                <!-- Logo / nom du site -->
                <a class="navbar-brand fw-bold" href="/">QuestExplorer</a>

                <!-- Bouton menu burger (mobile) -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Liens de navigation -->
                <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                    <ul class="navbar-nav">
                        <li class="nav-item"><a class="nav-link active" href="/">Accueil</a></li>
                        <li class="nav-item"><a class="nav-link" href="/hotels">Hôtels</a></li>
                        <li class="nav-item"><a class="nav-link" href="/contact">Contact</a></li>
                        <li class="nav-item"><a class="nav-link" href="/ajouter-hotel">Ajout d'Hôtel</a></li>
                        <li class="nav-item"><a class="btn btn-primary ms-2" href="#">Connexion</a></li>
                    </ul>
                </div>
            </div>
        </nav>

        <!-- ===================================================== -->
        <!-- SECTION HERO (bannière principale avec recherche) -->
        <!-- ===================================================== -->
        <section class="hero position-relative">
            <div class="container text-center text-white py-5">
                <h1 class="fw-bold">Explorez le monde avec QuestExplorer 🌍</h1>
                <p class="lead mt-3">Trouvez l’hôtel parfait, facilement et rapidement</p>
            </div>

            <!-- Barre de recherche flottante -->
            <div class="container search-box position-absolute start-50 translate-middle-x bg-white shadow-lg rounded-4 p-3"
                style="top: 80%; max-width: 1100px;">
                <form class="row gy-2 gx-2 align-items-end justify-content-center">

                    <!-- Type de séjour -->
                    <div class="col-12 col-sm-6 col-md-2">
                        <label for="typeVoyage" class="form-label fw-semibold text-dark mb-1">Type</label>
                        <select id="typeVoyage" class="form-select form-select-sm">
                            <option selected>Hôtel</option>
                            <option>Vol</option>
                            <option>Vol + Hôtel</option>
                            <option>Croisière</option>
                        </select>
                    </div>

                    <!-- Destination -->
                    <div class="col-12 col-sm-6 col-md-3">
                        <label for="destination" class="form-label fw-semibold text-dark mb-1">Destination</label>
                        <input type="search" id="destination" class="form-control form-control-sm"
                            placeholder="Ville ou pays...">
                    </div>

                    <!-- Dates -->
                    <div class="col-12 col-md-3">
                        <label class="form-label fw-semibold text-dark mb-1">Dates</label>
                        <div class="input-group input-group-sm">
                            <input type="date" class="form-control" id="depart">
                            <span class="input-group-text">→</span>
                            <input type="date" class="form-control" id="retour">
                        </div>
                    </div>

                    <!-- Voyageurs -->
                    <div class="col-12 col-md-3">
                        <label class="form-label fw-semibold text-dark mb-1">Voyageurs</label>
                        <div class="d-flex bg-white border rounded-3 shadow-sm p-2 justify-content-between">
                            <div class="text-center flex-fill mx-1">
                                <label class="small text-muted mb-0 d-block">Ad.</label>
                                <input type="number" class="form-control form-control-sm text-center fw-semibold"
                                    min="1" max="30" value="2">
                            </div>
                            <div class="text-center flex-fill mx-1">
                                <label class="small text-muted mb-0 d-block">Enf.</label>
                                <input type="number" class="form-control form-control-sm text-center fw-semibold"
                                    min="0" max="30" value="0">
                            </div>
                            <div class="text-center flex-fill mx-1">
                                <label class="small text-muted mb-0 d-block">Ch.</label>
                                <input type="number" class="form-control form-control-sm text-center fw-semibold"
                                    min="1" max="30" value="1">
                            </div>
                        </div>
                    </div>

                    <!-- Bouton -->
                    <div class="col-12 col-md-1 d-flex align-items-end justify-content-center">
                        <button type="submit" class="btn btn-primary w-100 py-2">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </form>
            </div>
        </section>



        <!-- ===================================================== -->
        <!-- SECTION HÔTELS POPULAIRES -->
        <!-- ===================================================== -->
        <div class="container" style="margin-top: 100px">
            <h2 class="section-title">Hôtels populaires</h2>
            <div class="row g-4">

                <% if (!hotels_populaires || hotels_populaires.length===0) { %>
                    <p class="text-center text-muted">Aucun hôtel pour le moment.</p>
                    <% } else { %>

                        <% hotels_populaires.forEach((hotel)=> { %>
                            <div class="col-md-4">
                                <div class="card h-100 shadow-sm tilt-card position-relative">
                                    <% if (hotel.is_promo) { %>
                                        <span class="badge bg-danger position-absolute top-0 start-0 m-3">
                                            -<%= hotel.promo_percent %>%
                                        </span>
                                        <% } %>


                                            <a href="/hotels/<%= hotel.id %>" class="stretched-link"></a>

                                            <img src="/hotels/<%= hotel.image || 'default.jpg' %>" class="card-img-top"
                                                alt="<%= hotel.nom %>">

                                            <div class="card-body">
                                                <h5 class="card-title">
                                                    <%= hotel.nom %>
                                                </h5>
                                                <p class="card-text text-muted">
                                                    <%= hotel.ville %>
                                                </p>
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <% const price=Number(hotel.prix_nuit ?? 0); const
                                                        promo=Number(hotel.promo_percent ?? 0); const
                                                        isPromo=hotel.is_promo && promo> 0;

                                                        const finalPrice = isPromo ? price * (1 - promo / 100) : price;
                                                        %>

                                                        <span class="fw-bold">
                                                            <% if (isPromo) { %>
                                                                <span
                                                                    class="text-muted small text-decoration-line-through me-2">
                                                                    <%= price.toFixed(2) %> €
                                                                </span>
                                                                <span>
                                                                    <%= finalPrice.toFixed(2) %> € / nuit
                                                                </span>
                                                                <% } else { %>
                                                                    <%= price.toFixed(2) %> € / nuit
                                                                        <% } %>
                                                        </span>

                                                        <span class="text-warning">
                                                            <%= "★" .repeat(hotel.etoiles) %>
                                                                <%= "☆" .repeat(5 - hotel.etoiles) %>
                                                        </span>
                                                </div>
                                            </div>

                                </div>
                            </div>
                            <% }) %>

                                <% } %>

            </div>
        </div>


        <!-- ===================================================== -->
        <!-- SECTION AVIS CLIENTS -->
        <!-- ===================================================== -->
        <section class="container py-5">
            <h2 class="text-center fw-bold mb-4">Avis de nos clients</h2>

            <% if (!reviews || reviews.length===0) { %>
                <div class="alert alert-secondary text-center">
                    Aucun avis disponible pour le moment.
                </div>
                <% } else { %>

                    <div id="reviewsCarousel" class="carousel slide" data-bs-ride="carousel">
                        <div class="carousel-inner">

                            <% for (let i=0; i < reviews.length; i +=3) { const chunk=reviews.slice(i, i + 3); %>

                                <div class="carousel-item <%= i === 0 ? 'active' : '' %>">
                                    <div class="row g-4 justify-content-center">

                                        <% chunk.forEach(r=> { %>
                                            <div class="col-12 col-md-6 col-lg-4">
                                                <div class="card h-100 border-0 shadow-sm text-center">
                                                    <div class="card-body">
                                                        <p class="fst-italic mb-3">“<%= r.comment %>”</p>

                                                        <div class="fw-semibold">
                                                            <%= r.author %>
                                                        </div>
                                                        <div class="text-muted small mb-2">
                                                            <%= r.hotelName %>
                                                        </div>

                                                        <div class="text-warning">
                                                            <% for (let s=1; s <=5; s++) { %>
                                                                <i
                                                                    class="bi <%= s <= r.rating ? 'bi-star-fill' : 'bi-star' %>"></i>
                                                                <% } %>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <% }) %>

                                    </div>
                                </div>

                                <% } %>

                        </div>

                        <button class="carousel-control-prev" type="button" data-bs-target="#reviewsCarousel"
                            data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Précédent</span>
                        </button>

                        <button class="carousel-control-next" type="button" data-bs-target="#reviewsCarousel"
                            data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Suivant</span>
                        </button>
                    </div>

                    <% } %>
        </section>

        <!--================================-->
        <!--    POURQUOI NOUS CHOISIR       -->
        <!-- https://icons.getbootstrap.com -->
        <!--================================-->

        <section class="container py-5">
            <h2 class="text-center fw-bold mb-4">Pourquoi choisir QuestExplorer ?</h2>

            <div class="row g-4">
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card h-100 border-0 shadow-sm text-center p-3">
                        <div class="display-6 mb-2 text-primary"><i class="bi bi-shield-check"></i></div>
                        <h6 class="fw-bold">Paiement sécurisé</h6>
                        <p class="text-muted small mb-0">Transactions protégées et données chiffrées.</p>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card h-100 border-0 shadow-sm text-center p-3">
                        <div class="display-6 mb-2 text-primary"><i class="bi bi-arrow-repeat"></i></div>
                        <h6 class="fw-bold">Annulation flexible</h6>
                        <p class="text-muted small mb-0">Des options adaptées à chaque réservation.</p>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card h-100 border-0 shadow-sm text-center p-3">
                        <div class="display-6 mb-2 text-primary"><i class="bi bi-headset"></i></div>
                        <h6 class="fw-bold">Support 7j/7</h6>
                        <p class="text-muted small mb-0">On t’aide rapidement, avant et après la réservation.</p>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card h-100 border-0 shadow-sm text-center p-3">
                        <div class="display-6 mb-2 text-primary"><i class="bi bi-tag"></i></div>
                        <h6 class="fw-bold">Meilleurs prix</h6>
                        <p class="text-muted small mb-0">Des offres sélectionnées pour ton budget.</p>
                    </div>
                </div>
            </div>
        </section>


        <!--======================-->
        <!--  OFFRE DU MOMENT     -->
        <!--======================-->
        <section class="container pb-5">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="fw-bold mb-0 mx-auto">Offres du moment</h2>
            </div>

            <div class="row g-4">
                <% if (!hotels_offres || hotels_offres.length===0) { %>
                    <p class="text-center text-muted">Aucune offre pour le moment.</p>
                    <% } else { %>

                        <% hotels_offres.forEach((h)=> {
                            // Calcul prix promo
                            const id = getId(h);
                            const price = Number(h.prix_nuit ?? 0);
                            const promo = Number(h.promo_percent ?? 0);
                            const isPromo = h.is_promo && promo > 0;

                            const finalPrice = isPromo ? price * (1 - promo / 100) : price;

                            const filename = (h.image && String(h.image).trim() !== "") ? h.image : "default.jpg";
                            const img = `/hotels/${filename}`;
                            %>

                            <div class="col-12 col-md-6 col-lg-4">
                                <div class="card h-100 border-0 shadow-sm position-relative overflow-hidden">

                                    <% if (isPromo) { %>
                                        <span class="badge bg-danger position-absolute top-0 start-0 m-3">
                                            -<%= promo %>%
                                        </span>
                                        <% } %>

                                            <img src="<%= img %>" class="card-img-top"
                                                style="height: 200px; object-fit: cover;" alt="<%= h.nom %>">

                                            <div class="card-body">
                                                <h5 class="card-title mb-1">
                                                    <%= h.nom %>
                                                </h5>
                                                <div class="text-muted small mb-2">
                                                    <%= h.ville %>
                                                </div>

                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div>
                                                        <% if (isPromo) { %>
                                                            <div class="text-muted small text-decoration-line-through">
                                                                <%= price.toFixed(2) %> € / nuit
                                                            </div>
                                                            <div class="fw-bold">
                                                                <%= finalPrice.toFixed(2) %> € / nuit
                                                            </div>
                                                            <% } else { %>
                                                                <div class="fw-bold">
                                                                    <%= price.toFixed(2) %> € / nuit
                                                                </div>
                                                                <% } %>
                                                    </div>

                                                    <% if (id !=null) { %>
                                                        <a href="<%= DETAIL_BASE %>/<%= id %>"
                                                            class="btn btn-primary btn-sm">Voir</a>
                                                        <% } %>
                                                </div>
                                            </div>
                                </div>
                            </div>

                            <% }) %>

                                <% } %>
            </div>
        </section>




        <!-- ===================================================== -->
        <!-- FOOTER -->
        <!-- ===================================================== -->
        <footer class="text-light pt-5 pb-3">
            <div class="container">
                <div class="row gy-4">

                    <!-- LOGO & DESCRIPTION -->
                    <div class="col-md-4">
                        <h5 class="fw-bold mb-3 text-uppercase">QuestExplorer</h5>
                        <p class="text-light">
                            Votre compagnon de voyage pour trouver les meilleurs hôtels au meilleur prix.
                            Découvrez des destinations uniques, des offres exclusives et une expérience simple.
                        </p>
                        <div class="d-flex gap-3 mt-3">
                            <a href="#" class="text-light"><i class="bi bi-facebook"></i></a>
                            <a href="#" class="text-light"><i class="bi bi-instagram"></i></a>
                            <a href="#" class="text-light"><i class="bi bi-twitter-x"></i></a>
                        </div>
                    </div>

                    <!-- LIENS UTILES -->
                    <div class="col-md-2">
                        <h6 class="fw-bold text-uppercase mb-3">Liens utiles</h6>
                        <ul class="list-unstyled">
                            <li><a href="/about_us" class="text-decoration-none">À propos</a></li>
                            <li><a href="/contact" class="text-decoration-none">Contact</a></li>
                            <li><a href="/hotels" class="text-decoration-none">Nos hôtels</a></li>
                            <li><a href="/" class="text-decoration-none">Conditions d’utilisation</a></li>
                            <li><a href="/" class="text-decoration-none">Confidentialité</a></li>
                        </ul>
                    </div>

                    <!-- DESTINATIONS POPULAIRES -->
                    <div class="col-md-3">
                        <h6 class="fw-bold text-uppercase mb-3">Destinations populaires</h6>
                        <ul class="list-unstyled">
                            <li><a href="/" class="text-decoration-none">Paris</a></li>
                            <li><a href="/" class="text-decoration-none">Nice</a></li>
                            <li><a href="/" class="text-decoration-none">Lyon</a></li>
                            <li><a href="/" class="text-decoration-none">Bordeaux</a></li>
                            <li><a href="/" class="text-decoration-none">Marseille</a></li>
                        </ul>
                    </div>

                    <!-- NEWSLETTER -->
                    <div class="col-md-3">
                        <h6 class="fw-bold text-uppercase mb-3">Newsletter</h6>
                        <p class="text-light">Abonnez-vous pour recevoir nos offres exclusives et bons plans voyage.</p>
                        <form class="d-flex flex-column flex-sm-row gap-2">
                            <input type="email" class="form-control" placeholder="Votre email" required>
                            <button class="btn btn-primary flex-shrink-0">S’abonner</button>
                        </form>
                    </div>
                </div>

                <hr class="my-4 border-secondary">

                <div class="text-center small">
                    © 2025 BookYourTravel — Créé par <strong>Yohann Giraudo</strong>. Tous droits réservés.
                </div>
            </div>
        </footer>

        <!-- Script Bootstrap -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>