<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Titre de la page -->
    <title>QuestExplorer - Accueil</title>

    <!-- Framework CSS Bootstrap + icônes officielles -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <!-- Feuille de style personnalisée -->
    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- ===================================================== -->
    <!-- NAVBAR (barre de navigation principale du site) -->
    <!-- ===================================================== -->
    <nav class="navbar navbar-expand-lg navbar-light bg-light shadow-sm">
        <div class="container">
            <!-- Logo / nom du site -->
            <a class="navbar-brand fw-bold" href="/">QuestExplorer</a>

            <!-- Bouton menu burger (mobile) -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Liens de navigation -->
            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link active" href="home">Accueil</a></li>
                    <li class="nav-item"><a class="nav-link" href="hotels">Hôtels</a></li>
                    <li class="nav-item"><a class="nav-link" href="contact">Contact</a></li>
                    <li class="nav-item"><a class="nav-link" href="ajouter-hotel">Ajout d'Hôtel</a></li>
                    <li class="nav-item"><a class="btn btn-primary ms-2" href="#">Connexion</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- ===================================================== -->
    <!-- SECTION HERO (bannière principale avec recherche) -->
    <!-- ===================================================== -->
<section class="hero position-relative">
  <div class="container text-center text-white py-5">
    <h1 class="fw-bold">Explorez le monde avec QuestExplorer 🌍</h1>
    <p class="lead mt-3">Trouvez l’hôtel parfait, facilement et rapidement</p>
  </div>

  <!-- Barre de recherche flottante -->
  <div class="container search-box position-absolute start-50 translate-middle-x bg-white shadow-lg rounded-4 p-3"
       style="top: 80%; max-width: 1100px;">
    <form class="row gy-2 gx-2 align-items-end justify-content-center">

      <!-- Type de séjour -->
      <div class="col-12 col-sm-6 col-md-2">
        <label for="typeVoyage" class="form-label fw-semibold text-dark mb-1">Type</label>
        <select id="typeVoyage" class="form-select form-select-sm">
          <option selected>Hôtel</option>
          <option>Vol</option>
          <option>Vol + Hôtel</option>
          <option>Croisière</option>
        </select>
      </div>

      <!-- Destination -->
      <div class="col-12 col-sm-6 col-md-3">
        <label for="destination" class="form-label fw-semibold text-dark mb-1">Destination</label>
        <input type="search" id="destination" class="form-control form-control-sm"
               placeholder="Ville ou pays...">
      </div>

      <!-- Dates -->
      <div class="col-12 col-md-3">
        <label class="form-label fw-semibold text-dark mb-1">Dates</label>
        <div class="input-group input-group-sm">
          <input type="date" class="form-control" id="depart">
          <span class="input-group-text">→</span>
          <input type="date" class="form-control" id="retour">
        </div>
      </div>

      <!-- Voyageurs -->
      <div class="col-12 col-md-3">
        <label class="form-label fw-semibold text-dark mb-1">Voyageurs</label>
        <div class="d-flex bg-white border rounded-3 shadow-sm p-2 justify-content-between">
          <div class="text-center flex-fill mx-1">
            <label class="small text-muted mb-0 d-block">Ad.</label>
            <input type="number" class="form-control form-control-sm text-center fw-semibold" min="1" max="30" value="2">
          </div>
          <div class="text-center flex-fill mx-1">
            <label class="small text-muted mb-0 d-block">Enf.</label>
            <input type="number" class="form-control form-control-sm text-center fw-semibold" min="0" max="30" value="0">
          </div>
          <div class="text-center flex-fill mx-1">
            <label class="small text-muted mb-0 d-block">Ch.</label>
            <input type="number" class="form-control form-control-sm text-center fw-semibold" min="1" max="30" value="1">
          </div>
        </div>
      </div>

      <!-- Bouton -->
      <div class="col-12 col-md-1 d-flex align-items-end justify-content-center">
        <button type="submit" class="btn btn-primary w-100 py-2">
          <i class="bi bi-search"></i>
        </button>
      </div>
    </form>
  </div>
</section>



    <!-- ===================================================== -->
    <!-- SECTION HÔTELS POPULAIRES -->
    <!-- ===================================================== -->
    <div class="container" style="margin-top: 100px">
        <h2 class="section-title">Hôtels populaires</h2>
        <div class="row g-4">

            <!-- Carte Hôtel -->
            <div class="col-md-4">
                <div class="card h-100 shadow-sm tilt-card">
                    <img src="renard.jpg" class="card-img-top" alt="Hôtel 1">
                    <div class="card-body">
                        <h5 class="card-title">Hôtel du Soleil</h5>
                        <p class="card-text text-muted">Nice — <span class="hotel-rating" data-rating="4.5"></span></p>
                    </div>
                </div>
            </div>

            <!-- Copie ce bloc pour ajouter un autre hôtel -->
            <div class="col-md-4">
                <div class="card h-100 shadow-sm tilt-card">
                    <img src="renard.jpg" class="card-img-top" alt="Hôtel 1">
                    <div class="card-body">
                        <h5 class="card-title">Hôtel du Sang</h5>
                        <p class="card-text text-muted">Pontarlier — <span class="hotel-rating"
                                data-rating="3.5"></span></p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 shadow-sm tilt-card">
                    <img src="renard.jpg" class="card-img-top" alt="Hôtel 1">
                    <div class="card-body">
                        <h5 class="card-title">Hôtel Bismuthe</h5>
                        <p class="card-text text-muted">Orange — <span class="hotel-rating" data-rating="4.1"></span>
                        </p>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- ===================================================== -->
    <!-- SECTION AVIS CLIENTS -->
    <!-- ===================================================== -->
    <div class="container">
        <h2 class="section-title">Avis de nos clients</h2>
        <div class="row g-4">
            <div class="col-md-6">
                <div class="border rounded p-4 shadow-sm avis">
                    <p class="fst-italic">“Super séjour ! Chambre impeccable, personnel très gentil.”</p>
                    <div class="text-end text-muted">— Alice D. ★★★★★</div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="border rounded p-4 shadow-sm avis">
                    <p class="fst-italic">“Vue incroyable, petit déjeuner excellent.”</p>
                    <div class="text-end text-muted">— Marc L. ★★★★☆</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ===================================================== -->
    <!-- SECTION DESTINATIONS POPULAIRES -->
    <!-- ===================================================== -->
    <div class="container my-5">
        <h2 class="section-title">Destinations en vogue</h2>
        <div class="row g-4 justify-content-center">

            <!-- Exemple de carte de destination -->
            <div class="col-md-3">
                <div class="card border-0 shadow-sm tilt-card">
                    <a href="hotels" class="stretched-link"></a>
                    <img src="renard.jpg" class="card-img-top" alt="Rome">
                    <div class="card-body text-center">
                        <h6>Rome</h6>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm tilt-card">
                    <a href="hotels" class="stretched-link"></a>
                    <img src="renard.jpg" class="card-img-top" alt="Rome">
                    <div class="card-body text-center">
                        <h6>Rome</h6>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm tilt-card">
                    <a href="hotels" class="stretched-link"></a>
                    <img src="renard.jpg" class="card-img-top" alt="Rome">
                    <div class="card-body text-center">
                        <h6>Rome</h6>
                    </div>
                </div>
            </div>
            <!-- Copier ce bloc pour ajouter d’autres destinations -->
        </div>
    </div>

