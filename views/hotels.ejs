<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hôtels</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/style.css">
</head>

<body class="bg-light">

    <!-- HERO SECTION -->
    <section class="hero-hotels d-flex align-items-center text-center text-white">
        <div class="container">
            <h1 class="display-5 fw-bold">Nos Hôtels Partenaires</h1>
            <p class="lead">Découvrez les établissements qui font confiance à QuestExplorer.</p>
        </div>
    </section>

    <!-- HOTEL LIST -->
    <div class="container py-5">
        <h2 class="text-center mb-4">Liste des Hôtels</h2>

        <div class="row g-4">

            <% if (!hotels || hotels.length===0) { %>
                <p class="text-center text-muted">Aucun hôtel trouvé dans la base de données.</p>
                <% } else { %>

                    <% hotels.forEach((hotel)=> { %>
                        <div class="col-md-4">
                            <div class="card h-100 shadow-sm tilt-card position-relative">

                                <a href="/hotels/<%= hotel.id %>" class="stretched-link"></a>

                                <img src="/hotels/<%= hotel.image || 'default.jpg' %>" class="card-img-top"
                                    alt="<%= hotel.nom %>">

                                <div class="card-body text-center">
                                    <h5 class="card-title">
                                        <%= hotel.nom %>
                                    </h5>
                                    <p class="card-text text-muted">
                                        <%= hotel.ville %>
                                    </p>
                                    <p class="fw-bold">
                                        <%= hotel.prix_nuit %> € / nuit
                                    </p>
                                </div>

                            </div>
                        </div>
                        <% }) %>

                            <% } %>
        </div>
    </div>

    <!-- BUTTON RETURN -->
    <div class="text-center mt-3 mb-5">
        <a href="/" class="btn btn-primary">
            <i class="bi bi-arrow-left"></i> Retour à l'accueil
        </a>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>